flowchart TB
    User([User]) --> HTML["index.html<br/>App shell"]

    subgraph Frontend["Frontend (ES Modules)"]
        HTML --> app["app.js<br/>Entry point"]
        app --> state["state.js<br/>Convex client + auth"]
        app --> render["render.js<br/>Body map + panels"]
        app --> events["events.js<br/>User interactions"]
        app --> data["data.js<br/>Body zones + schemas"]
        app --> utils["utils.js<br/>Helpers"]
    end

    subgraph Convex["Convex Backend"]
        state -->|"mutations / queries"| auth["auth.ts<br/>Login / register"]
        state -->|"mutations / queries"| profiles["profiles.ts<br/>CRUD + password"]
        auth & profiles --> DB[("Database<br/>users, profiles")]
    end

    state <-->|"localStorage"| Storage[("Browser Storage<br/>user session")]
